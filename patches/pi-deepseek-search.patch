 // ---------------------------------------------------------------------------
+// Claude Code look: "● Web Search(\"query\")" + "  └ Did 1 search in 12s"
+// ---------------------------------------------------------------------------
+
+const ELBOW = "  └ ";
+const INDENT = "    ";
+const XML_TAG = /<[^>]*(?:tool_calls|invoke|parameter)[^>]*>/g;
+
+export function cleanAnswer(body: string): string {
+  return body.replace(XML_TAG, "").replace(/\n*REMINDER:.*$/s, "").replace(/\n+$/, "");
+}
+
+export function searchSummary(details: unknown, sourceCount: number): string {
+  const ms = (details as { durationMs?: unknown } | undefined)?.durationMs;
+  const took = typeof ms === "number" ? ` in ${Math.max(1, Math.round(ms / 1000))}s` : "";
+  const found = sourceCount > 0 ? ` (${sourceCount} source${sourceCount === 1 ? "" : "s"})` : "";
+  return `Did 1 search${took}${found}`;
+}
