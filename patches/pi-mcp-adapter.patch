+const MAX_COMPACT_ARG_VALUE_CHARS = 60;
+const MAX_COMPACT_ARGS_PREVIEW_CHARS = 160;
+const MAX_COMPACT_ARGS_KEYS = 4;
+
+function splitPrefixedName(name: string): { server: string; tool: string } {
+  const separatorIndex = name.indexOf("_");
+  if (separatorIndex === -1) return { server: "", tool: name };
+  return { server: name.slice(0, separatorIndex), tool: name.slice(separatorIndex + 1) };
+}
+
+function formatCompactArgValue(value: unknown): string {
+  if (typeof value === "string") return truncateText(JSON.stringify(value), MAX_COMPACT_ARG_VALUE_CHARS);
+  if (typeof value === "number" || typeof value === "boolean") return truncateText(String(value), MAX_COMPACT_ARG_VALUE_CHARS);
+  try {
+    return truncateText(JSON.stringify(value), MAX_COMPACT_ARG_VALUE_CHARS);
+  } catch {
+    return truncateText(String(value), MAX_COMPACT_ARG_VALUE_CHARS);
+  }
+}
+
+function formatCompactArgsPreview(args: Record<string, unknown> | undefined): string {
+  if (!hasUsefulObjectContent(args)) return "";
+  const keys = Object.keys(args as Record<string, unknown>);
+  const shownKeys = keys.slice(0, MAX_COMPACT_ARGS_KEYS);
+  const parts = shownKeys.map((key) => `${key}: ${formatCompactArgValue((args as Record<string, unknown>)[key])}`);
+  if (keys.length > MAX_COMPACT_ARGS_KEYS) parts.push("…");
+  return truncateText(`(${parts.join(", ")})`, MAX_COMPACT_ARGS_PREVIEW_CHARS);
+}
+
+function resolveCompactArgsObject(args: string | Record<string, unknown> | undefined): Record<string, unknown> | undefined {
+  if (typeof args !== "string") return args;
+  try {
+    const parsed: unknown = JSON.parse(args);
+    return hasUsefulObjectContent(parsed) ? (parsed as Record<string, unknown>) : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+interface McpCompactCallDisplay {
+  title: string;
+  argsPreview: string;
+  server?: string;
+}
+
+function formatMcpCompactCallDisplay(server: string, tool: string, args: Record<string, unknown> | undefined): McpCompactCallDisplay {
+  return {
+    title: server ? `${server} - ${tool} (MCP)` : `${tool} (MCP)`,
+    argsPreview: formatCompactArgsPreview(args),
+    server: server || undefined,
+  };
+}
+
+function formatMcpProxyCompactDisplay(args: McpProxyToolCallInput): McpCompactCallDisplay | undefined {
+  if (!args.tool) return undefined;
+  const { server, tool } = args.server ? { server: args.server, tool: args.tool } : splitPrefixedName(args.tool);
+  return formatMcpCompactCallDisplay(server, tool, resolveCompactArgsObject(args.args));
+}
