+function formatMcpCompactTitleLine(title: string, argsPreview: string, theme: RenderTheme): string {
+  const styledBullet = theme.fg("success", theme.bold ? theme.bold(COMPACT_BULLET) : COMPACT_BULLET);
+  const styledTitle = theme.fg("toolTitle", theme.bold ? theme.bold(title) : title);
+  const styledArgs = argsPreview ? theme.fg("toolTitle", argsPreview) : "";
+  return `${styledBullet}${styledTitle}${styledArgs}`;
+}
+
+function formatMcpCompactRunningRow(subject: string, theme: RenderTheme): string {
+  return `${blinkOn() ? theme.fg("muted", COMPACT_BULLET) : "  "}Calling ${subject}…`;
+}
+
+function formatMcpCompactDoneRow(server: string | undefined, title: string, theme: RenderTheme): string {
+  return theme.fg("muted", server ? `Called ${server}` : title);
+}
+
+function formatMcpCompactErrorRow(result: Pick<AgentToolResult<McpToolResultDetails>, "content">, theme: RenderTheme): string {
+  const display = collectCollapsedResultLines(result.content, 1, DEFAULT_MAX_COLLAPSED_CHARS);
+  return theme.fg("error", `${COMPACT_RESULT_PREFIX}${display.lines[0] ?? ""}`);
+}
+
+function compactServer(context: McpToolRenderContext | undefined, details: McpToolResultDetails): string | undefined {
+  if (context?.state?.compactServer) return context.state.compactServer;
+  if (details.mode !== "call") return undefined;
+  if (typeof details.server === "string") return details.server;
+  return typeof details.hintServer === "string" ? details.hintServer : undefined;
+}
+
+function formatMcpCompactExpandedRows(result: Pick<AgentToolResult<McpToolResultDetails>, "content">, theme: RenderTheme): string {
+  const display = formatMcpToolResultLines(result, true);
+  return display.lines.map((line) => `${COMPACT_RESULT_CONTINUATION_PREFIX}${theme.fg("toolOutput", line)}`).join("\n");
+}
+
+function computeHiddenResultLineCount(result: Pick<AgentToolResult<McpToolResultDetails>, "content">, shownLineCount: number): number {
+  const totalLines = result.content.flatMap(blockToLines).length;
+  return Math.max(0, totalLines - shownLineCount);
+}
+
+function formatMcpCompactResultRows(shownLines: string[], hiddenLineCount: number, theme: RenderTheme): string {
+  const bodyLines = shownLines.length > 0 ? shownLines : [""];
+  const rows = bodyLines.map((line, index) => {
+    const prefix = index === 0 ? theme.fg("toolTitle", COMPACT_RESULT_PREFIX) : COMPACT_RESULT_CONTINUATION_PREFIX;
+    return `${prefix}${theme.fg(index === 0 ? "toolTitle" : "toolOutput", line)}`;
+  });
+  if (hiddenLineCount > 0) {
+    rows[rows.length - 1] += theme.fg("muted", ` … +${hiddenLineCount} lines (ctrl+o to expand)`);
+  }
+  return rows.join("\n");
+}
+
+function buildCompactMcpToolResultContent(
+  result: AgentToolResult<McpToolResultDetails>,
+  options: ToolRenderResultOptions,
+  theme: RenderTheme,
+  context: McpToolRenderContext | undefined,
+  renderOptions: McpToolRenderOptions,
+): string {
+  const title = context?.state?.compactTitle ?? formatMcpToolResultIdentity(result.details) ?? "";
+  const argsPreview = context?.state?.compactInputPreview ?? "";
+  const server = compactServer(context, result.details);
+  const isError = context?.isError === true || Boolean(result.details.error);
+
+  if (options.isPartial) return formatMcpCompactRunningRow(server ?? title, theme);
+  if (!options.expanded && !isError) return formatMcpCompactDoneRow(server, title, theme);
+
+  const titleLine = title ? formatMcpCompactTitleLine(title, argsPreview, theme) : "";
+  let resultRow: string;
+  if (options.expanded) {
+    resultRow = formatMcpCompactExpandedRows(result, theme);
+  } else {
+    resultRow = formatMcpCompactErrorRow(result, theme);
+  }
+  return [titleLine, resultRow].filter((line) => line.length > 0).join("\n");
+}
