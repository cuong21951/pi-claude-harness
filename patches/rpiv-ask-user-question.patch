+export function answeredRows(details: QuestionnaireResult | undefined, theme: Pick<Theme, "fg">): string[] {
+	const answers = details?.answers ?? [];
+	if (!details || details.cancelled || answers.length === 0) return [theme.fg("muted", "● ") + theme.fg("toolTitle", DECLINE_MESSAGE)];
+	const rows = answers.map((a, i) => theme.fg("muted", (i === 0 ? "  ⎿  " : "     ") + `· ${a.question} → ${formatAnswerScalar(a, "summary")}`));
+	return [theme.fg("muted", "● ") + theme.fg("toolTitle", "User answered Claude's questions:"), ...rows];
+}
